<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinSpaces.Gui</RootNamespace>
    <StartupObject>WinSpaces.Gui.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Dummy MSBuild Tasks for CLI build without Visual Studio -->
  <UsingTask TaskName="RemovePayloadDuplicates" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Inputs ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <ProjectName ParameterType="System.String" />
      <Platform ParameterType="System.String" />
      <VsTelemetrySession ParameterType="System.String" />
      <Filtered ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        Filtered = Inputs;
      </Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="ExpandPayloadDirectories" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Inputs ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <VsTelemetrySession ParameterType="System.String" />
      <Expanded ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        Expanded = Inputs;
      </Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="Microsoft.Build.Packaging.Pri.Tasks.ExpandPriContent" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Inputs ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <MakePriExeFullPath ParameterType="System.String" />
      <MakePriExtensionPath ParameterType="System.String" />
      <IntermediateDirectory ParameterType="System.String" />
      <AdditionalMakepriExeParameters ParameterType="System.String" />
      <ExcludeXamlFromLibraryLayoutsWhenXbfIsPresent ParameterType="System.String" />
      <VsTelemetrySession ParameterType="System.String" />
      <Expanded ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
      <IntermediateFileWrites ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        Expanded = new Microsoft.Build.Framework.ITaskItem[0];
        IntermediateFileWrites = new Microsoft.Build.Framework.ITaskItem[0];
      </Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="GetDefaultResourceLanguage" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ProjectFile ParameterType="System.String" />
      <SourceAppxManifest ParameterType="System.String" />
      <DefaultLanguage ParameterType="System.String" />
      <VsTelemetrySession ParameterType="System.String" />
      <DefaultResourceLanguage ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        DefaultResourceLanguage = "en-US";
      </Code>
    </Task>
  </UsingTask>

</Project>
